<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.craftmarket.mapper.VendorMapper">

    <!-- 根据手机号查询摊主 -->
    <select id="selectByPhone" resultType="com.craftmarket.entity.Vendor">
        SELECT * FROM vendor
        WHERE phone = #{phone} AND deleted = 0
    </select>

    <!-- 根据经营品类查询摊主列表 -->
    <select id="selectVendorsByBusinessType" resultType="com.craftmarket.entity.Vendor">
        SELECT * FROM vendor 
        WHERE business_type = #{businessType} AND deleted = 0
        ORDER BY create_time DESC
    </select>

</mapper>